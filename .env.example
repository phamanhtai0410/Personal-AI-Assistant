# Cursor — mint at https://cursor.com/dashboard/cloud-agents
CURSOR_API_KEY=cursor_...

# Slack Socket Mode app tokens
# Create app from slack-app-manifest.yaml at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Comma-separated if multiple people may talk to the bot
SLACK_ALLOWED_USER_ID=U0123456789

# Paths (defaults suit local dev; on VPS use /var/lib/pai/...)
PAI_VAULT_DIR=./vault
PAI_DATA_DIR=./data
PAI_DB_PATH=./data/pai.db

# Default Cursor model (override per chat with /model, or globally with /model global <id>)
# Common: composer-2, composer-2.5, auto — run /models in Slack to see what your account has
PAI_MODEL_ID=composer-2.5

# Daily run cap to protect Pro usage pool
PAI_DAILY_RUN_CAP=40

# Briefing cron (cron expression, local TZ of the host)
PAI_BRIEFING_CRON=0 8 * * *
PAI_BRIEFING_ENABLED=true
PAI_TIMEZONE=Asia/Ho_Chi_Minh

# Optional: Slack channel/DM to deliver briefing (defaults to first allowed user DM)
# PAI_BRIEFING_CHANNEL=D0123456789
